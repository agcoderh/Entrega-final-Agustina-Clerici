      "parameters": {
        "jsCode": "const data = JSON.parse($input.item.json.text);\nconst mensajeOriginal = $('Gmail Trigger').item.json.snippet;\nconst servicios = $('Base Airtable (servicios)').all();\nconst match = servicios.find(item => item.json.fields['Nombre del servicio'] === data.servicio);\n\nreturn [{\n  json: {\n    servicio: data.servicio,\n    prioridad: data.prioridad,\n    razon: data.razon,\n    mensajeOriginal: mensajeOriginal,\n    descripcionServicio: match ? match.json.fields['Descripción'] : '',\n    servicioRecordId: match ? match.json.id : null\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
